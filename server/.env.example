# Скопируйте в .env и заполните. Файл .env не коммитить.
#
# Телефон в той же сети ходит на http://<IP-ПК>:3000.
# Для этого Windows Firewall должен пускать входящий TCP на порт PORT.
# Обход по USB: adb reverse tcp:3000 tcp:3000,
# тогда базовый URL в приложении — http://127.0.0.1:3000.

OPENAI_API_KEY=
APP_SECRET=
PORT=3000
